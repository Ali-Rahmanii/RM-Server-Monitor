# ─── تلگرام ───
# توکن ربات را از @BotFather بگیر. تا وقتی خالی باشد، ربات تلگرام
# غیرفعال می‌ماند ولی داشبورد وب و زمان‌بند به کار خودشان ادامه می‌دهند.
TELEGRAM_BOT_TOKEN=

# آی‌دی عددی ادمین‌ها (چند نفر با کاما جدا شوند). فقط این افراد
# می‌توانند دستورات ربات را اجرا کنند و هشدار دریافت می‌کنند.
TELEGRAM_ADMIN_IDS=

# ─── دیتابیس ───
DB_PATH=monitorbot.db

# ─── فاصله‌ی چک خودکار (دقیقه) — بعداً از /setinterval یا داشبورد هم قابل تغییر است
MONITOR_INTERVAL_MINUTES=30

# ─── داشبورد وب ───
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_USERNAME=admin
WEB_PASSWORD=changeme

# ─── آستانه‌ی هشدار بحرانی (درصد) ───
CPU_ALERT_THRESHOLD=90
RAM_ALERT_THRESHOLD=90
DISK_ALERT_THRESHOLD=90

# ─── تایم‌اوت هر فراخوانی به یک ایجنت (ثانیه) ───
AGENT_REQUEST_TIMEOUT=15

# ─── چند ردیف تاریخچه به ازای هر سرور نگه داشته شود ───
MAX_LOG_ROWS_PER_SERVER=2000
