# این توکن باید دقیقاً همان چیزی باشد که موقع ثبت این سرور در سیستم
# مرکزی (با /addserver یا از داشبورد وب) وارد می‌کنی. اگر با install.sh
# نصب کنی، این فایل و یک توکن تصادفی امن خودش ساخته می‌شود.
AGENT_TOKEN=

# پورتی که ایجنت رویش گوش می‌دهد
AGENT_PORT=5100

# چند تا از پرمصرف‌ترین پردازش‌ها در هر فراخوانی برگردانده شود
AGENT_TOP_N=5
